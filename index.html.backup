<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DataGlif - AI-Ready Data at Scale</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Archivo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --surface-deepest: #05070C;
      --surface-deep: #0A0D12;
      --surface-mid: #0F131C;
      --accent-cyan: #38BDF8;
      --accent-lime: #d4ff00;
      --white: #ffffff;
      --gray-300: #d1d5db;
      --gray-700: #374151;
      --gray-900: #111827;

      /* Chart theme variables */
      --dex-ink: #e2e8f0;
      --dex-blue: #38BDF8;
      --dex-sky: #67c7eb;
      --dex-band: rgba(56, 189, 248, 0.15);
      --dex-warning: #f97316;
      --dex-grid: rgba(255, 255, 255, 0.12);
      --dex-muted: #94a3b8;
      --dex-surface: var(--surface-mid);

      /* Service cards */
      --card-1: #0d0f12;
      --card-2: #17191d;
      --card-3: #202226;
      --card-4: #2a2c30;
      --card-5: #34363a;
      --card-6: #3e4044;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #FFFFFF;
      color: #000000;
      font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      overflow-x: hidden;
    }

    /* Navbar - Compact and transparent */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 0.75rem 3rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: transparent;
      backdrop-filter: none;
      border-bottom: none;
    }

    .navbar-logo {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: #000000;
      letter-spacing: -0.02em;
    }

    .navbar-nav {
      display: flex;
      align-items: center;
      gap: 2rem;
      flex: 1;
      justify-content: center;
    }

    .nav-item {
      position: relative;
      font-family: 'IBM Plex Sans', sans-serif;
      font-size: 0.875rem;
      font-weight: 400;
      color: #000000;
      cursor: pointer;
      transition: color 200ms ease;
      text-decoration: none;
    }

    .nav-item:hover {
      color: var(--accent-cyan);
    }

    .navbar-actions {
      display: flex;
      align-items: center;
    }

    /* CTA Button - Stable (no movement on hover) */
    .cta-button {
      display: inline-flex;
      align-items: center;
      gap: clamp(0.3rem, 1vw, 0.5rem);
      border: 2px solid rgba(0, 0, 0, 0.2);
      border-radius: 9999px;
      padding: clamp(0.3rem, 0.8vw, 0.4rem);
      background: transparent;
      cursor: pointer;
      outline: none;
      transition: all 300ms ease;
      font-family: 'DM Sans', sans-serif;
    }

    .cta-button:hover {
      border-color: rgba(0, 0, 0, 0.4);
    }

    .cta-button:active {
      transform: scale(0.98);
    }

    .cta-button-label {
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background: #000000;
      padding: clamp(0.4rem, 1.5vw, 0.65rem) clamp(1rem, 4vw, 1.75rem);
      font-weight: 700;
      font-size: clamp(0.75rem, 2.5vw, 0.9rem);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      color: #FFFFFF;
      transition: all 300ms ease;
      white-space: nowrap;
      line-height: 1;
    }

    .cta-button:hover .cta-button-label {
      background: var(--accent-lime);
      color: var(--gray-900);
    }

    .cta-button-arrow {
      display: grid;
      place-items: center;
      aspect-ratio: 1;
      border-radius: 9999px;
      background: #000000;
      padding: clamp(0.4rem, 1.8vw, 0.65rem);
      transition: all 300ms ease;
    }

    .cta-button:hover .cta-button-arrow {
      background: var(--accent-lime);
    }

    .cta-button-arrow svg {
      width: clamp(0.75rem, 3vw, 1rem);
      height: clamp(0.75rem, 3vw, 1rem);
      color: #FFFFFF;
      transition: all 300ms ease-out;
    }

    .cta-button:hover .cta-button-arrow svg {
      color: var(--gray-900);
      transform: rotate(45deg);
    }

    /* Video Hero Styles */
    .hero-container {
      height: 200vh;
      position: relative;
      padding-top: 60px;
      background: #FFFFFF;
    }

    .hero-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 2rem;
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      padding: 2rem;
      border: 1px solid rgba(0, 0, 0, 0.15);
      border-radius: 16px;
      overflow: hidden;
      background: #FFFFFF;
    }

    .video-card {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 0;
      overflow: hidden;
      background: #FFFFFF;
      will-change: transform, opacity;
      border: 3px solid rgba(0, 0, 0, 0);
      transition: border-color 400ms ease;
    }

    .video-card.separated {
      border-color: rgba(0, 0, 0, 0.2);
    }

    .video-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.35);
      z-index: 1;
      pointer-events: none;
    }

    .video-card video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .video-label-overlay {
      position: absolute;
      top: 2rem;
      left: 2rem;
      z-index: 2;
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(1.25rem, 3vw, 2rem);
      font-weight: 700;
      color: var(--white);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      opacity: 0;
      transition: opacity 400ms ease;
    }

    .video-card.active .video-label-overlay {
      opacity: 1;
    }

    .video-description {
      position: absolute;
      bottom: -5rem;
      left: 0;
      right: 0;
      text-align: center;
      font-family: 'DM Sans', sans-serif;
      font-size: clamp(0.875rem, 1.8vw, 1rem);
      color: rgba(0, 0, 0, 0.7);
      opacity: 0;
      transition: opacity 600ms ease;
      padding: 0 1rem;
      line-height: 1.5;
    }

    .video-card.separated .video-description {
      opacity: 1;
    }

    .hero-content {
      position: absolute;
      z-index: 10;
      text-align: center;
      max-width: 1400px;
      padding: 2rem;
      will-change: transform, opacity;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .brand {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(3rem, 8vw, 14.375rem); /* 230px */
      font-weight: 500; /* Medium */
      color: #FFFFFF;
      margin-bottom: 2rem;
      letter-spacing: -0.02em;
      line-height: 1;
    }

    .tagline {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(2rem, 5vw, 3.75rem);
      font-weight: 600;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
      line-height: 1.1;
      display: none; /* Hide "Where Data Evolves" */
    }

    .description {
      font-family: 'DM Sans', sans-serif;
      font-size: clamp(1rem, 2vw, 1.5rem); /* Reduced from 64px to ~24px */
      font-weight: 400; /* Regular */
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.95);
      max-width: 900px;
      margin: 0 auto 2.5rem;
      letter-spacing: -0.01em;
      text-align: center;
    }

    .hero-cta {
      margin-top: 2rem;
    }

    /* Chart Section - Reversed Layout */
    .chart-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8rem 3rem;
      background: var(--surface-deep);
      position: relative;
    }

    .chart-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    }

    .chart-container {
      max-width: 1400px;
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 6rem;
      align-items: center;
    }

    .chart-intro {
      text-align: left;
    }

    .chart-intro h2 {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(2.25rem, 4.5vw, 3.5rem);
      font-weight: 600;
      margin-bottom: 1.5rem;
      color: #FFFFFF;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }

    .chart-intro p {
      font-family: 'DM Sans', sans-serif;
      font-size: clamp(1.125rem, 2.2vw, 1.375rem);
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.8);
      font-weight: 400;
      margin-bottom: 1rem;
    }

    /* Data Exhaustion Chart Styles */
    .dex-chart {
      width: 100%;
      color: var(--dex-ink);
      font-family: 'IBM Plex Sans', sans-serif;
    }

    .dex-chart__header {
      display: grid;
      gap: 8px;
      margin: 0 0 16px;
    }

    .dex-chart__eyebrow {
      margin: 0;
      color: var(--accent-cyan);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .dex-chart__title {
      max-width: 40rem;
      margin: 0;
      color: var(--white);
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(1.25rem, 2.8vw, 1.75rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.15;
    }

    .dex-chart__legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
      margin: 0 0 16px;
      padding: 0;
      color: var(--dex-muted);
      font-family: 'IBM Plex Sans', sans-serif;
      font-size: 0.75rem;
      line-height: 1.3;
      list-style: none;
    }

    .dex-chart__legend-item {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      white-space: nowrap;
    }

    .dex-chart__legend-swatch {
      display: inline-block;
      width: 20px;
      height: 10px;
      flex: 0 0 auto;
      background-position: center;
      background-repeat: no-repeat;
    }

    .dex-chart__legend-swatch--actual {
      width: 10px;
      height: 10px;
      border: 1.5px solid var(--dex-ink);
      border-radius: 50%;
      background: var(--dex-sky);
    }

    .dex-chart__legend-swatch--historical {
      background-image: repeating-linear-gradient(to right, var(--dex-blue) 0 6px, transparent 6px 10px);
    }

    .dex-chart__legend-swatch--projection {
      height: 3px;
      border-radius: 1px;
      background: var(--dex-warning);
    }

    .dex-chart__legend-swatch--bounds {
      height: 9px;
      border-top: 2px dotted var(--dex-warning);
      border-bottom: 2px dotted var(--dex-warning);
      background: var(--dex-band);
    }

    .dex-chart__legend-swatch--current {
      background-image: repeating-linear-gradient(to right, var(--dex-blue) 0 5px, transparent 5px 9px);
    }

    .dex-chart__svg {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
    }

    .dex-chart__grid line {
      stroke: var(--dex-grid);
      stroke-dasharray: 3 6;
      stroke-width: 1;
    }

    .dex-chart__stock-band {
      fill: var(--dex-band);
      transform-box: fill-box;
      transform-origin: left center;
    }

    .dex-chart__bound {
      stroke: var(--dex-warning);
      stroke-dasharray: 2.5 6;
      stroke-linecap: round;
      stroke-width: 2.2;
    }

    .dex-chart__historical {
      stroke: var(--dex-blue);
      stroke-dasharray: 8 7;
      stroke-linecap: round;
      stroke-width: 3.5;
    }

    .dex-chart__projection {
      stroke: var(--dex-warning);
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 5.5;
    }

    .dex-chart__current-marker {
      stroke: var(--dex-blue);
      stroke-dasharray: 7 7;
      stroke-linecap: round;
      stroke-width: 2.5;
    }

    .dex-chart__model-dot {
      fill: var(--dex-sky);
      stroke: var(--dex-ink);
      stroke-width: 1.6;
    }

    .dex-chart__leader {
      fill: none;
      stroke: var(--dex-muted);
      stroke-width: 1;
    }

    .dex-chart__model-label,
    .dex-chart__current-label,
    .dex-chart__tick-label,
    .dex-chart__axis-title,
    .dex-chart__callout text {
      fill: var(--dex-ink);
      font-family: 'IBM Plex Sans', sans-serif;
    }

    .dex-chart__model-label {
      font-size: 14px;
      font-weight: 700;
    }

    .dex-chart__current-label {
      fill: var(--dex-blue);
      font-size: 13px;
      font-weight: 700;
    }

    .dex-chart__callout rect {
      fill: var(--surface-mid);
      stroke: var(--dex-warning);
      stroke-width: 1.5;
    }

    .dex-chart__callout text {
      font-size: 13px;
      font-weight: 700;
    }

    .dex-chart__exhaustion-dot {
      fill: var(--dex-warning);
      stroke: var(--dex-surface);
      stroke-width: 2;
    }

    .dex-chart__exhaustion-pulse {
      fill: none;
      opacity: 0;
      stroke: var(--dex-warning);
      stroke-width: 2;
    }

    .dex-chart__frame {
      fill: none;
      stroke: var(--dex-ink);
      stroke-width: 1.25;
    }

    .dex-chart__tick {
      stroke: var(--dex-ink);
      stroke-width: 1.25;
    }

    .dex-chart__tick-label {
      fill: var(--dex-muted);
      font-size: 14px;
      font-weight: 500;
    }

    .dex-chart__axis-title {
      font-family: 'DM Sans', sans-serif;
      font-size: 15px;
      font-weight: 700;
    }

    .dex-chart__caption {
      margin-top: 12px;
      color: var(--dex-muted);
      font-family: 'IBM Plex Sans', sans-serif;
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .dex-chart__caption a {
      color: var(--accent-cyan);
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }

    /* Services Section */
    .services-hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 10rem 3rem 6rem;
      background: #FFFFFF;
    }

    .services-hero-content {
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    .services-hero h1 {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(3rem, 9vw, 6.5rem);
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: #000000;
      margin-bottom: 2.5rem;
    }

    .services-hero h1 .muted {
      color: rgba(0, 0, 0, 0.35);
    }

    .services-hero p {
      font-family: 'DM Sans', sans-serif;
      font-size: clamp(1.125rem, 2vw, 1.25rem);
      line-height: 1.6;
      color: rgba(0, 0, 0, 0.6);
      max-width: 600px;
      margin-bottom: 3.5rem;
    }

    .scroll-hint {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.875rem;
      color: rgba(0, 0, 0, 0.4);
    }

    .scroll-hint span:first-child {
      animation: smooth-float 2s ease-in-out infinite;
    }

    @keyframes smooth-float {
      0%, 100% { transform: translateY(0); opacity: 1; }
      50% { transform: translateY(-8px); opacity: 0.7; }
    }

    /* Service Cards - Complete Rewrite */
    .services-container {
      position: relative;
      background: #FFFFFF;
    }

    .card-pin-spacer {
      height: 400vh;
    }

    .cards-sticky-wrapper {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    .cards-inner {
      position: relative;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .service-card {
      position: absolute;
      width: 100%;
      max-width: 1400px;
      height: 78vh;
      border-radius: 32px;
      padding: 3.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: white;
      box-shadow: 0 20px 80px rgba(0, 0, 0, 0.3);
      transform-origin: center top;
      will-change: transform;
    }

    .service-card-header {
      display: flex;
      align-items: start;
      justify-content: flex-end;
    }

    .service-card-eyebrow {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: rgba(255, 255, 255, 0.4);
    }

    .service-card-title {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(4rem, 12vw, 7rem);
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.03em;
      margin: 0;
    }

    .service-card-title .line-1 {
      display: block;
      color: #FFFFFF;
    }

    .service-card-title .line-2 {
      display: block;
      color: rgba(255, 255, 255, 0.45);
    }

    .service-card-footer {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: end;
    }

    @media (min-width: 768px) {
      .service-card-footer {
        grid-template-columns: 1fr 1.1fr;
      }
    }

    .service-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
    }

    .service-tag {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.06);
      color: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);
      transition: background 200ms ease;
    }

    .service-description {
      display: flex;
      align-items: start;
      gap: 0.75rem;
      font-family: 'DM Sans', sans-serif;
      font-size: clamp(1.125rem, 2vw, 1.25rem);
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.7);
    }

    .service-icon {
      flex-shrink: 0;
      width: 1.5rem;
      height: 1.5rem;
      margin-top: 0.125rem;
    }

    @media (max-width: 768px) {
      .services-hero {
        padding: 6rem 1.5rem 4rem;
      }

      .service-card {
        padding: 2rem;
      }

      .cards-inner {
        padding: 1rem;
      }
    }

    /* Chart Animations */
    .dex-chart[data-animation-state="idle"] .dex-chart__grid,
    .dex-chart[data-animation-state="idle"] .dex-chart__axes {
      opacity: 0;
    }

    .dex-chart[data-animation-state="idle"] .dex-chart__stock-band {
      opacity: 0;
      transform: scaleX(0);
    }

    .dex-chart[data-animation-state="idle"] .dex-chart__model-point,
    .dex-chart[data-animation-state="idle"] .dex-chart__annotations,
    .dex-chart[data-animation-state="idle"] .dex-chart__legend {
      opacity: 0;
    }

    .dex-chart[data-animation-state="playing"] .dex-chart__grid,
    .dex-chart[data-animation-state="playing"] .dex-chart__axes {
      animation: dex-fade-in 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .dex-chart[data-animation-state="playing"] .dex-chart__stock-band {
      animation: dex-band-in 500ms cubic-bezier(0.22, 1, 0.36, 1) 180ms both;
    }

    .dex-chart[data-animation-state="playing"] .dex-chart__model-point {
      animation: dex-point-in 410ms cubic-bezier(0.19, 1, 0.22, 1) 720ms both;
    }

    .dex-chart[data-animation-state="playing"] .dex-chart__annotations,
    .dex-chart[data-animation-state="playing"] .dex-chart__legend {
      animation: dex-fade-rise 430ms cubic-bezier(0.22, 1, 0.36, 1) 1200ms both;
    }

    .dex-chart[data-animation-state="playing"] .dex-chart__exhaustion-pulse {
      animation: dex-pulse 560ms cubic-bezier(0.22, 1, 0.36, 1) 1500ms both;
    }

    @keyframes dex-fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes dex-band-in {
      from { opacity: 0; transform: scaleX(0); }
      to { opacity: 1; transform: scaleX(1); }
    }

    @keyframes dex-point-in {
      from { opacity: 0; transform: scale(0.45); }
      to { opacity: 1; transform: scale(1); }
    }

    @keyframes dex-fade-rise {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes dex-pulse {
      0% { opacity: 0; transform: scale(0.5); }
      35% { opacity: 0.9; }
      100% { opacity: 0; transform: scale(2.7); }
    }

    @media (max-width: 1024px) {
      .chart-container {
        grid-template-columns: 1fr;
        gap: 4rem;
      }

      .chart-intro {
        text-align: center;
      }

      .navbar-nav {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .navbar {
        padding: 0.75rem 1.5rem;
      }

      .navbar-actions {
        gap: 1rem;
      }

      .nav-login {
        display: none;
      }

      .chart-section {
        padding: 4rem 1.5rem;
      }

      .dex-chart__title {
        font-size: 1.25rem;
      }

      .dex-chart__legend {
        gap: 6px 10px;
        font-size: 0.68rem;
      }
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-logo">DataGlif</div>

    <div class="navbar-nav">
      <a href="#home" class="nav-item">Home</a>
      <a href="#services" class="nav-item">Services</a>
      <a href="#approach" class="nav-item">Our Approach</a>
      <a href="#contact" class="nav-item">Contact</a>
    </div>

    <div class="navbar-actions">
      <button class="cta-button" onclick="window.location.href='#contact'">
        <span class="cta-button-label">Book a Call</span>
        <span class="cta-button-arrow">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>
    </div>
  </nav>

  <!-- Video Hero Section -->
  <div class="hero-container">
    <div class="hero-sticky">
      <div class="video-wrapper">
        <!-- Video 1: Drone (plays first) -->
        <div class="video-card" data-video="1">
          <video src="./videos/city_drone_.mp4" autoplay loop muted playsinline></video>
          <div class="video-label-overlay">Aerial / Geo</div>
          <div class="video-description">High-altitude surveillance and geographic mapping data for spatial intelligence</div>
        </div>

        <!-- Video 2: CCTV -->
        <div class="video-card" data-video="2">
          <video src="./videos/cctv-construction-zone.mp4" autoplay loop muted playsinline></video>
          <div class="video-label-overlay">Scene / Object</div>
          <div class="video-description">Real-world scene understanding and object detection from fixed camera feeds</div>
        </div>

        <!-- Video 3: People -->
        <div class="video-card" data-video="3">
          <video src="./videos/people_walking_official.mp4" autoplay loop muted playsinline></video>
          <div class="video-label-overlay">Segmentation</div>
          <div class="video-description">Precise instance segmentation for human activity analysis and crowd dynamics</div>
        </div>
      </div>

      <div class="hero-content">
        <div class="brand">DataGlif<br>Where Data Evolves</div>
        <p class="description">
          DataGlif transforms raw, unstructured information into clean, validated, and production-ready datasets.<br>
          We power AI and agentic systems with high-quality, human-validated data.
        </p>
        <div class="hero-cta">
          <button class="cta-button" onclick="window.location.href='#contact'">
            <span class="cta-button-label">Request a Dataset</span>
            <span class="cta-button-arrow">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Data Exhaustion Chart Section -->
  <div class="chart-section">
    <div class="chart-container">
      <!-- Text Left -->
      <div class="chart-intro">
        <h2>The Data Exhaustion Challenge</h2>
        <p>
          As AI models grow exponentially, we're approaching a critical inflection point:
          the world's supply of training data.
        </p>
        <p>
          See how compute-optimal demand projects to meet available data stocks by 2027 — and why quality,
          human-validated datasets are the key to sustaining AI progress.
        </p>
      </div>

      <!-- Chart Right -->
      <div id="chart-root"></div>
    </div>
  </div>

  <!-- Services Hero Section -->
  <section class="services-hero">
    <div class="services-hero-content">
      <h1>
        Choose the<br>
        <span class="muted">data services</span><br>
        you need
      </h1>
      <p>
        Already have data? Bring your own dataset and we will clean, enrich,
        annotate, QA, or review it. Scroll to explore the stack.
      </p>
      <div class="scroll-hint">
        <span>↓</span>
        <span>Scroll</span>
      </div>
    </div>
  </section>

  <!-- Services Cards Container -->
  <div class="services-container">
    <div class="card-pin-spacer">
      <div class="cards-sticky-wrapper">
        <div class="cards-inner">

          <!-- Card 1 -->
          <div class="service-card" style="background-color: var(--card-1);" data-index="0">
            <div class="service-card-header">
              <span class="service-card-eyebrow">Data Services</span>
            </div>
            <h2 class="service-card-title">
              <span class="line-1">Data</span>
              <span class="line-2">Collection</span>
            </h2>
            <div class="service-card-footer">
              <div class="service-tags">
                <span class="service-tag">Web extraction</span>
                <span class="service-tag">Surveys</span>
                <span class="service-tag">Schema mapping</span>
                <span class="service-tag">API harvesting</span>
              </div>
              <div class="service-description">
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1" stroke-linecap="round" />
                </svg>
                <span>Targeted sourcing from public, licensed, and API sources. Custom surveys and data harvesting built around the questions you actually need answered.</span>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="service-card" style="background-color: var(--card-2);" data-index="1">
            <div class="service-card-header">
              <span class="service-card-eyebrow">Data Services</span>
            </div>
            <h2 class="service-card-title">
              <span class="line-1">Data</span>
              <span class="line-2">Annotation</span>
            </h2>
            <div class="service-card-footer">
              <div class="service-tags">
                <span class="service-tag">NER</span>
                <span class="service-tag">Bounding boxes</span>
                <span class="service-tag">Polygons</span>
                <span class="service-tag">Sentiment</span>
                <span class="service-tag">RLHF</span>
                <span class="service-tag">Segmentation</span>
              </div>
              <div class="service-description">
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1" stroke-linecap="round" />
                </svg>
                <span>Expert labeling for NLP, vision, video, and multimodal models — using your guidelines or creating them from scratch.</span>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="service-card" style="background-color: var(--card-3);" data-index="2">
            <div class="service-card-header">
              <span class="service-card-eyebrow">Data Services</span>
            </div>
            <h2 class="service-card-title">
              <span class="line-1">Data</span>
              <span class="line-2">Cleaning</span>
            </h2>
            <div class="service-card-footer">
              <div class="service-tags">
                <span class="service-tag">Deduplication</span>
                <span class="service-tag">Validation</span>
                <span class="service-tag">Missing value resolution</span>
                <span class="service-tag">Normalization</span>
              </div>
              <div class="service-description">
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1" stroke-linecap="round" />
                </svg>
                <span>Remove noise, fix inconsistencies, deduplicate, and normalize your existing datasets until they are ready for production.</span>
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="service-card" style="background-color: var(--card-4);" data-index="3">
            <div class="service-card-header">
              <span class="service-card-eyebrow">Data Services</span>
            </div>
            <h2 class="service-card-title">
              <span class="line-1">Data</span>
              <span class="line-2">Enrichment</span>
            </h2>
            <div class="service-card-footer">
              <div class="service-tags">
                <span class="service-tag">Metadata enrichment</span>
                <span class="service-tag">Categorization</span>
                <span class="service-tag">Taxonomy mapping</span>
              </div>
              <div class="service-description">
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1" stroke-linecap="round" />
                </svg>
                <span>Add metadata, categorizations, geocoding, cross-references, and layers of intelligence that make your data compound in value.</span>
              </div>
            </div>
          </div>

          <!-- Card 5 -->
          <div class="service-card" style="background-color: var(--card-5);" data-index="4">
            <div class="service-card-header">
              <span class="service-card-eyebrow">Data Services</span>
            </div>
            <h2 class="service-card-title">
              <span class="line-1">Dataset</span>
              <span class="line-2">QA</span>
            </h2>
            <div class="service-card-footer">
              <div class="service-tags">
                <span class="service-tag">Accuracy audit</span>
                <span class="service-tag">Consistency checks</span>
                <span class="service-tag">Gold set creation</span>
              </div>
              <div class="service-description">
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1" stroke-linecap="round" />
                </svg>
                <span>Rigorous quality assurance, sampling, inter-annotator agreement, and adjudication so you can trust every row.</span>
              </div>
            </div>
          </div>

          <!-- Card 6 -->
          <div class="service-card" style="background-color: var(--card-6);" data-index="5">
            <div class="service-card-header">
              <span class="service-card-eyebrow">Data Services</span>
            </div>
            <h2 class="service-card-title">
              <span class="line-1">Human</span>
              <span class="line-2">Review</span>
            </h2>
            <div class="service-card-footer">
              <div class="service-tags">
                <span class="service-tag">Edge cases</span>
                <span class="service-tag">Escalation</span>
                <span class="service-tag">Nuance validation</span>
              </div>
              <div class="service-description">
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1" stroke-linecap="round" />
                </svg>
                <span>Deep human-in-the-loop verification for edge cases, subjective labels, and high-stakes decisions no model should make alone.</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- GSAP & Lenis -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>

  <script src="./chart-component.js"></script>

  <script>
    // Video Hero Animation
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smooth: true,
      smoothTouch: false,
    });

    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    gsap.registerPlugin(ScrollTrigger);
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    const videoCards = gsap.utils.toArray('.video-card');
    gsap.set(videoCards, {
      width: '100%',
      height: '100%',
      borderRadius: 0,
      opacity: 0,
      zIndex: 1
    });

    let currentVideoIndex = 0;
    let isScrolling = false;

    // Video cycling timeline - drone plays first (video 1)
    const videoCycleTl = gsap.timeline({
      repeat: -1,
      onUpdate: function() {
        if (!isScrolling) {
          const progress = this.progress();
          const totalDuration = this.duration();
          const singleVideoDuration = 5.5;
          currentVideoIndex = Math.floor((progress * totalDuration) / singleVideoDuration) % 3;
        }
      }
    });

    videoCards.forEach((card, i) => {
      videoCycleTl
        .to(card, { opacity: 1, duration: 1.5, ease: 'power2.inOut' }, i * 5.5)
        .to(card, { opacity: 1, duration: 2.5 }, i * 5.5 + 1.5)
        .to(card, { opacity: 0, duration: 1.5, ease: 'power2.inOut' }, i * 5.5 + 4);
    });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.hero-container',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.2,
        onEnter: () => {
          isScrolling = true;
          videoCycleTl.pause();
          videoCards.forEach((card, i) => {
            if (i !== currentVideoIndex) {
              gsap.set(card, { opacity: 0 });
              card.classList.remove('separated');
            } else {
              gsap.set(card, { opacity: 1, zIndex: 3 });
              card.classList.add('active');
            }
          });
        },
        onLeaveBack: () => {
          isScrolling = false;
          videoCycleTl.play();
          videoCards.forEach(card => {
            card.classList.remove('active', 'separated');
          });
        },
        onUpdate: (self) => {
          // Add white borders when cards start separating (after 20% scroll progress)
          if (self.progress > 0.2) {
            videoCards.forEach(card => card.classList.add('separated'));
          } else {
            videoCards.forEach(card => card.classList.remove('separated'));
          }
        }
      }
    });

    const getPositions = (centerIndex) => {
      const positions = [-680, 0, 680];
      const rotations = [-6, 0, 6];
      const result = [];
      const order = [
        (centerIndex + 2) % 3,
        centerIndex,
        (centerIndex + 1) % 3
      ];
      order.forEach((videoIndex, posIndex) => {
        result[videoIndex] = {
          x: positions[posIndex],
          rotateY: rotations[posIndex],
          zIndex: posIndex === 1 ? 3 : 2
        };
      });
      return result;
    };

    const positions = getPositions(currentVideoIndex);

    // Bigger video cards with less spacing
    tl.to(videoCards, {
      width: '560px',
      height: '400px',
      borderRadius: '20px',
      scale: 0.92,
      duration: 0.35,
      ease: 'power2.inOut'
    }, 0);

    videoCards.forEach((card, i) => {
      const pos = positions[i];
      tl.to(card, {
        x: pos.x,
        scale: 1,
        rotateY: pos.rotateY,
        z: pos.zIndex === 3 ? 60 : 0,
        opacity: 1,
        zIndex: pos.zIndex,
        duration: 0.7,
        ease: 'expo.out',
        onComplete: () => {
          if (i === currentVideoIndex || pos.zIndex === 3) {
            card.classList.add('active');
          }
        }
      }, 0.25 + (i === currentVideoIndex ? 0.05 : Math.abs(i - currentVideoIndex) * 0.05));
    });

    tl.to('.hero-content', {
      opacity: 0,
      scale: 0.88,
      y: -60,
      filter: 'blur(8px)',
      ease: 'power2.inOut'
    }, 0);

    // Services Cards Stacking Animation - From Scratch
    const cards = gsap.utils.toArray('.service-card');
    const spacer = document.querySelector('.card-pin-spacer');

    cards.forEach((card, index) => {
      const scale = 1 - ((cards.length - index) * 0.05);
      const topOffset = 11 + (index * 26); // Start at 11vh, 26px increments

      gsap.set(card, {
        transformOrigin: 'center top',
        top: `${topOffset}vh`,
        scale: scale,
        zIndex: cards.length - index
      });
    });

    ScrollTrigger.create({
      trigger: spacer,
      start: 'top top',
      end: 'bottom bottom',
      pin: '.cards-sticky-wrapper',
      pinSpacing: false
    });
  </script>

</body>
</html>
